# Environment Configuration Template (Never commit actual passwords or keys)

# Django Core
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-this-secret-key-for-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_AUTH_USER_MODEL=auth.User

# PostgreSQL Database Connection
POSTGRES_DB=job
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Combined Database URL
DATABASE_URL=postgres://postgres:your-postgres-password@127.0.0.1:5432/job

# Redis
REDIS_URL=redis://127.0.0.1:6379/0
